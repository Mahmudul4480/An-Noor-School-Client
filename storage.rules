rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /admission-forms/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /student-photos/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /birth-reg-docs/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
