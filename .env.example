# Firebase (client-side — use VITE_ prefix for Vite)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Optional: only if you use Firebase Analytics
# VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Demo login for local development (set false in production)
VITE_ENABLE_DEMO_LOGIN=true

# Online payment gateway (optional — enable when gateway is integrated)
# VITE_PAYMENT_GATEWAY_ENABLED=true
# VITE_PAYMENT_GATEWAY_PROVIDER=sslcommerz
# VITE_PAYMENT_GATEWAY_KEY=your_gateway_key_here

# GEMINI_API_KEY: Required for Gemini AI API calls.
# Keep server-side only — never use VITE_ prefix for secrets.
GEMINI_API_KEY=your_gemini_api_key_here

# APP_URL: The URL where this app is hosted (OAuth callbacks, links, etc.)
APP_URL=http://localhost:3000
